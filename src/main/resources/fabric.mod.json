{
  "schemaVersion": 1,
  "id": "guishop",
  "version": "${version}",
  "name": "ClassicGUIShop",
  "description": "A vanilla chest shop with a persistent economy and an optional client Adminshop for layouts, prices, server settings, and transaction records.",
  "authors": ["Zycu", "Original GUIShop authors: _Waffles_ and AlreadyCoded"],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["com.zycu.guishop.GuiShop"],
    "client": ["com.zycu.guishop.client.AdminShopClient"]
  },
  "mixins": [
    "guishop.mixins.json",
    {"config": "guishop.client.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=${loader_minimum}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}"
  },
  "suggests": { "fabric-api": "*", "fabric-permissions-api-v0": ">=${permissions_api}" },
  "breaks": { "fabric-permissions-api-v0": "<${permissions_api}" }
}
